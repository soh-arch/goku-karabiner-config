    [:##left_shift    ["layer-bra" 1] [:!layer-ast :layer-cket] {:afterup ["layer-bra" 0] :alone :!Sgrave_accent_and_tilde}]
    [:##right_shift   ["layer-cket" 1] [:!layer-ast :!layer-bra] {:afterup ["layer-cket" 0] :alone :backslash}]
    [:##right_shift   ["layer-cket" 1] [:!layer-ast :layer-bra] {:afterup ["layer-cket" 0] :alone :!Sbackslash}]
    [:##left_option   :left_option nil {:alone :greek}]
    [:##left_command  ["layer-ast" 1] nil {:afterup ["layer-ast" 0] :alone :english}]
    [:##spacebar      :left_shift nil {:alone :spacebar}]
    [:##right_command :right_command nil {:alone :japanese_kana}]
    [:##right_option  :right_option]
    [:##fn            :left_control]
   ]}

