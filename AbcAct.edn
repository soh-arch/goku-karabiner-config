;; ## AbcAct
;; A: Asterisk / B: Bra / C: Cket + Act axis

;; ### Legend
;; > ### Goku Abbreviated Notation
;; > S: L-Shift
;; > C: L-Cmd
;; > O: L-Opt
;; > T: L-Ctrl
;; > R: R-Shift
;; > E: R-Opt
;; > ### Layers
;; > *: Asterisk (= layer-ast / L-Cmd held)
;; > <: Bra       (= layer-bra / L-Shift held)
;; > >: Cket      (= layer-cket / R-Shift held)
;; > ### Asterisk Axes
;; > Position — where you act
;; >   L: Left   (home-row apps + act keys)
;; >   R: Right  (navigation suite)
;; >   B: Bottom (symbols / clips / fn)
;; > Act — how the position behaves
;; >   a: Amplify, Alter, App(L)
;; >   s: Select, Store(B)
;; >   d: Delete, Display, Draw(B)
;; >   f: Focus, Function(B)
;; > ### Chord (Act mask)
;; > asdf = no acts
;; > Asdf = act-a
;; > aSdf = act-s
;; > asDf = act-d
;; > asdF = act-f
;; > (Capitals combine; e.g. aSDf = act-s + act-d)

;; ### Asterisk Right × Act
;; asdf: Text Cursor
;; Asdf: Amplified Text Cursor
;; aSdf: Select
;; ASdf: Amplified Select
;; asDf: Delete
;; AsDf: Amplified Delete
;; aSDf: Reconversion & Copy Paste
;; ASDf: Undo/Redo & Duplicate/Move Line
;; asdF: Mouse Cursor
;; AsdF: Fast Mouse Cursor
;; aSdF: Placement
;; ASdF: Screen Placement
;; asDF: Tab
;; AsDF: Window
;; aSDF: App
;; ASDF: Space

;; ### Asterisk Left × Act
;; asdf: Apps Primary
;; Asdf: Apps Alternate

;; ### Asterisk Bottom × Act
;; asdf: Symbols Primary
;; Asdf: Symbols Alternate
;; aSdf: Save Clip
;; asDf: Load Clip
;; asdF: Function Keys

;; ### Bra Suite
;; Numpad: virtual number pad

;; ### Cket Suites
;; Media: volume / brightness / illumination / playback

;; ### Terminal Overrides (Asterisk Right, iTerm2 only)
;; The text-editing tiers re-emit shell control sequences instead of
;; macOS editing keys; tiers with no shell equivalent send nothing.

;; ### Escape Suite (Asterisk, destructive system actions)
;; asdf: Lock screen (no Act)
;; Asdf: Sleep
;; aSdf: Restart
;; asDf: Log out

;; ### Tab Suite (Asterisk, focus jump)
;; asdf: Ctrl+F4 (active/next window)
;; asdF: Ctrl+F2 (menu bar)

;; ### Numpad-a Suite (Simlayer, experimental — Asterisk-independent)
;; Numpad: virtual number pad, trigger key `a`

{
 :templates {
  :app          "open -a '%s'"
  :ray-bg       "open -g 'raycast://extensions/%s'"
  :ray-fg       "open 'raycast://extensions/%s'"
  :wm           "open -g 'raycast://extensions/raycast/window-management/%s'"
  :sys-evt      "osascript -e 'tell app \"System Events\" to %s'"
  :pwr          "pmset %s"
  :clip-save    "mkdir -p ~/.cache/abcact/clips && sleep 0.1 && pbpaste > ~/.cache/abcact/clips/%s"
  :clip-load    "cat ~/.cache/abcact/clips/%s | pbcopy && sleep 0.1"
  :clip-airdrop "export TMP=\"$TMPDIR/clip.png\"; osascript -l JavaScript -e 'ObjC.import(\"AppKit\"); var pb = $.NSPasteboard.generalPasteboard; var data = pb.dataForType(\"public.png\"); if (data.isNil()) { Application(\"System Events\").displayDialog(\"No image available\", {buttons: [\"OK\"]}) } else { data.writeToFileAtomically($.NSProcessInfo.processInfo.environment.objectForKey(\"TMP\").js, true) }' && shortcuts run \"AirDrop Clip\" -i \"$TMP\"" ;; requires the "AirDrop Clip" Shortcuts.app shortcut, not tracked in this repo (see NOTES.md)
 }

 :applications {
  :terminal ["^com\\.googlecode\\.iterm2$"]
 }

 :input-sources {
  :english {:input_source_id "com.apple.keylayout.USExtended"}
  :greek   {:input_source_id "com.apple.keylayout.Greek"}
 }

 :simlayers {
  :numpad-a {:key :a :condi [:!layer-ast :!layer-bra :!layer-cket :!layer-maccy]}
 }

