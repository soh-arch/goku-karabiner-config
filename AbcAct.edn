    [:##v             :f5 [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :act-f]]
    [:##b             :f6 [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :act-f]]
    [:##n             :f7 [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :act-f]]
    [:##m             :f8 [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :act-f]]
    [:##comma         :f9 [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :act-f]]
    [:##period        :f10 [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :act-f]]
    [:##slash         :f11 [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :act-f]]
    [:##right_shift   :f12 [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :act-f]]
   ]}

  {:des "Bra: Virtual Numpad"
   :rules [
    [:z :0 [:layer-bra :!layer-ast]]
    [:x :1 [:layer-bra :!layer-ast]]
    [:c :2 [:layer-bra :!layer-ast]]
    [:v :3 [:layer-bra :!layer-ast]]
    [:s :4 [:layer-bra :!layer-ast]]
    [:d :5 [:layer-bra :!layer-ast]]
    [:f :6 [:layer-bra :!layer-ast]]
    [:w :7 [:layer-bra :!layer-ast]]
    [:e :8 [:layer-bra :!layer-ast]]
    [:r :9 [:layer-bra :!layer-ast]]
    [:a :delete_or_backspace [:layer-bra :!layer-ast]]
    [:q [:end :!Shome :delete_or_backspace] [:layer-bra :!layer-ast]]
   ]}

  {:des "Bra: Depiction"
   ;; Bra (L-Shift) + Spacebar held together, not Bra alone (would collide with the Virtual Numpad).
   ;; Spacebar forwards a real Command modifier without touching layer-ast, which is what lets these
   ;; Cmd+<key> chords fire while :!layer-ast holds. Mirrors the shortcuts in Concepts (iPad) drawing app.
   :rules [
    [:!C1 :!Chyphen [:layer-bra :!layer-ast]]
    [:!C2 :!Cequal_sign [:layer-bra :!layer-ast]]
    [:!C3 :l [:layer-bra :!layer-ast]]
    [:!C4 :!Sl [:layer-bra :!layer-ast]]
    [:!Cq :!Scomma [:layer-bra :!layer-ast]]
    [:!Cw :!Speriod [:layer-bra :!layer-ast]]
    [:!Ce :e [:layer-bra :!layer-ast]]
    [:!Cr :b [:layer-bra :!layer-ast]]
    [:!Ca :comma [:layer-bra :!layer-ast]]
    [:!Cs :period [:layer-bra :!layer-ast]]
    [:!Cd :!Cz [:layer-bra :!layer-ast]]
    [:!Cf :!CSz [:layer-bra :!layer-ast]]
    [:!Cz :!Ocomma [:layer-bra :!layer-ast]]
    [:!Cx :!Operiod [:layer-bra :!layer-ast]]
    [:!Cc :a [:layer-bra :!layer-ast]]
    [:!Cv :t [:layer-bra :!layer-ast]]
   ]}

  {:des "Cket: Media Controls"
   :rules [
    [:open_bracket    :volume_decrement [:layer-cket :!layer-ast]]
    [:close_bracket   :volume_increment [:layer-cket :!layer-ast]]
    [:backslash       :mute [:layer-cket :!layer-ast]]
    [:semicolon       :display_brightness_decrement [:layer-cket :!layer-ast]]
    [:quote           :display_brightness_increment [:layer-cket :!layer-ast]]
    [:period          :illumination_decrement [:layer-cket :!layer-ast]]
    [:slash           :illumination_increment [:layer-cket :!layer-ast]]
    [:!Ropen_bracket  :fast_forward [:layer-cket :!layer-ast]]
    [:!Rclose_bracket :rewind [:layer-cket :!layer-ast]]
    [:!Rbackslash     :play_or_pause [:layer-cket :!layer-ast]]
   ]}
 ]
}
