;; ## AbcAct
;; A: Asterisk / B: Bra / C: Cket + Act axis

;; ### Legend
;; > ### Goku Abbreviated Notation
;; > S: L-Shift
;; > C: L-Cmd
;; > O: L-Opt
;; > T: L-Ctrl
;; > R: R-Shift
;; > ### Layers
;; > *: Asterisk (= layer-ast / L-Cmd held)
;; > <: Bra       (= layer-bra / L-Shift held)
;; > >: Cket      (= layer-cket / R-Shift held)
;; > ### Asterisk Axes
;; > Position — where you act
;; >   L: Left   (home-row apps + act keys)
;; >   R: Right  (navigation suite)
;; >   B: Bottom (symbols / clips / fn)
;; > Act — how the position behaves
;; >   a: Amplify, Alter, App(L)
;; >   s: Select, Store(B)
;; >   d: Delete, Display, Draw(B)
;; >   f: Focus, Function(B)
;; > ### Chord (Act mask)
;; > asdf = no acts
;; > Asdf = act-a
;; > aSdf = act-s
;; > asDf = act-d
;; > asdF = act-f
;; > (Capitals combine; e.g. aSDf = act-s + act-d)

;; ### Asterisk Right × Act
;; asdf: Text Cursor
;; Asdf: Amplified Text Cursor
;; aSdf: Select
;; ASdf: Amplified Select
;; asDf: Delete
;; AsDf: Amplified Delete
;; aSDf: Undo, Navigate & Convert
;; ASDf: Copy Paste
;; asdF: Mouse Cursor
;; AsdF: Fast Mouse Cursor
;; aSdF: Drag & Drop
;; ASdF: Fast Drag & Drop
;; asDF: Tab Management
;; AsDF: App Management
;; aSDF: Window Management
;; ASDF: Amplified Window Management

;; ### Asterisk Left × Act
;; asdf: Apps Primary
;; Asdf: Apps Alternate

;; ### Asterisk Bottom × Act
;; asdf: Symbols Primary
;; Asdf: Symbols Alternate
;; aSdf: Save Clip
;; asDf: Load Clip
;; asdF: Function Keys

;; ### Bra Suites
;; Numpad:    virtual number pad
;; Depiction: drawing palette

;; ### Cket Suites
;; Media: volume / brightness / illumination / playback

{
 :templates {
  :app          "open -a '%s'"
  :ray          "open -g 'raycast://extensions/%s'"
  :wm           "open -g 'raycast://extensions/raycast/window-management/%s'"
  :sys-evt      "osascript -e 'tell app \"System Events\" to %s'"
  :pwr          "pmset %s"
  :clip-save    "mkdir -p ~/.cache/abcact/clips && sleep 0.1 && pbpaste > ~/.cache/abcact/clips/%s"
  :clip-load    "cat ~/.cache/abcact/clips/%s | pbcopy && sleep 0.1"
  :clip-airdrop "osascript -e 'set tmp to POSIX path of (path to temporary items) & \"clip.png\"' -e 'try' -e 'set img to the clipboard as «class PNGf»' -e 'set f to open for access POSIX file tmp with write permission' -e 'set eof f to 0' -e 'write img to f' -e 'close access f' -e 'on error' -e 'display dialog \"No image available\" buttons {\"OK\"}' -e 'return' -e 'end try' -e 'tell application \"Finder\"' -e 'activate' -e 'reveal (POSIX file tmp as alias)' -e 'end tell' -e 'tell application \"System Events\" to tell process \"Finder\"' -e 'delay 0.1' -e 'click (first button of toolbar 1 of window 1 whose description is \"共有\" or description is \"Share\")' -e 'delay 0.1' -e 'key code 36' -e 'end tell'"
 }

 :input-sources {
  :english  {:input_source_id "com.apple.keylayout.USExtended"}
  :greek    {:input_source_id "com.apple.keylayout.Greek"}
  :japanese {:input_source_id "com.apple.inputmethod.Kotoeri.RomajiTyping.Japanese"}
 }

 :main [
  {:des "Core: Layer Activators"
   :rules [
    [:##left_shift    ["layer-bra" 1] [:!layer-ast :!layer-cket] {:afterup ["layer-bra" 0] :alone :grave_accent_and_tilde}] ;; ) Bra / alone `
    [:##left_shift    ["layer-bra" 1] [:!layer-ast :layer-cket] {:afterup ["layer-bra" 0] :alone :!Sgrave_accent_and_tilde}] ;; Shift+L-Shift → ~
    [:##right_shift   ["layer-cket" 1] [:!layer-ast :!layer-bra] {:afterup ["layer-cket" 0] :alone :backslash}] ;; ( Cket / alone \
    [:##right_shift   ["layer-cket" 1] [:!layer-ast :layer-bra] {:afterup ["layer-cket" 0] :alone :!Sbackslash}] ;; Shift+R-Shift → |
    [:##left_option   :left_option nil {:alone :greek}]
    [:##left_command  ["layer-ast" 1] nil {:afterup ["layer-ast" 0] :alone :english}]  ;; * Asterisk
    [:##spacebar      :left_command nil {:alone :spacebar}]
    [:##right_command :left_shift nil {:alone :japanese}]
    [:##right_option  :left_shift]
   ]}

  {:des "Core: Space & Return"
   :rules [
    [:##open_bracket  :return_or_enter [:layer-ast :!act-a :!act-s :!act-d :!act-f]]
    [:##close_bracket :return_or_enter [:layer-ast :!act-a :!act-s :!act-d :!act-f]]
    [:##backslash     :spacebar [:layer-ast :!act-a :!act-s :!act-d :!act-f]]
    [:##semicolon     :return_or_enter [:layer-ast :!act-a :!act-s :!act-d :!act-f]]
    [:##quote         :return_or_enter [:layer-ast :!act-a :!act-s :!act-d :!act-f]]
   ]}

  {:des "Core: Accents"
   :rules [
    [:open_bracket    :!Oe [:!layer-ast :!layer-cket]]
    [:close_bracket   :!Ograve_accent_and_tilde [:!layer-ast :!layer-cket]]
    [:backslash       :!Oq [:!layer-ast :!layer-cket]]
    [:!Sopen_bracket  :!O6 [:!layer-ast :!layer-cket]]
    [:!Sclose_bracket :!Ou [:!layer-ast :!layer-cket]]
    [:!Sbackslash     :!Oc [:!layer-ast :!layer-cket]]
   ]}

  {:des "Core: Capslock Actions"
   :rules [
    [:##caps_lock     :delete_or_backspace [:layer-ast :!layer-maccy :!layer-bra :!layer-cket :!act-a :!act-s :!act-d :!act-f]] ;; テキスト選択後に削除するため
